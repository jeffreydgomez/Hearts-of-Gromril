# Local operating-system and Python caches.
.DS_Store
__pycache__/
*.py[cod]

# Saved games are never part of the published mod.
*.hoi4

# Development sources live in the separate Hearts of Gromril Dev Stuff folder.
# Keep only the user's chosen public notes and credits in this directory.
/Dev Stuff/*
!/Dev Stuff/To Do.md
!/Dev Stuff/AGENTS.md
!/Dev Stuff/CREDITS.md
